# Your store's myshopify subdomain, without ".myshopify.com"
SHOPIFY_SHOP=your-store
# From the app's Settings page in the Shopify Dev Dashboard
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional: use a fixed Admin API token instead of the client credentials grant
SHOPIFY_ACCESS_TOKEN=
# Admin API version
SHOPIFY_API_VERSION=2026-10
# true = log what would change, but do not change inventory
DRY_RUN=true
# Optional: location to take blanks from when an order has no location (defaults to the primary location)
DEFAULT_LOCATION_ID=
